# Depot PUBLIC et consigne du prof : aucun secret dans ce projet.
# Ces valeurs sont factices et volontairement versionnees, pour que
# n'importe qui -- y compris une autre equipe -- puisse cloner et lancer
# le projet sans rien configurer.
#
# En contexte reel : ce fichier ne serait PAS committe, et le mot de passe
# vivrait dans un Secret Kubernetes ou un gestionnaire dedie.

DB_NAME=tasksdb
DB_USER=tasks
DB_PASSWORD=tasks-demo-password

FRONTEND_PORT=8080
APP_VERSION=dev

# ---- PRODUCTION (docker-compose.prod.yml) --------------------------------
# A MODIFIER : remplacez par votre depot, EN MINUSCULES.
# Exemple : ghcr.io/etudiant/projet-devops
IMAGE_PREFIX=ghcr.io/chaimaberrahil99/projet-devops
TAG=latest
