# Ce fichier est un TEMPLATE. L'image officielle Nginx remplace ${BACKEND_URL}
# par la variable d'environnement au demarrage du conteneur.
# Consequence : aucune adresse de backend n'est figee dans l'image, donc la
# meme image tourne en staging, en prod, et sur l'infra de n'importe quelle
# equipe SysOps. C'est exactement la portabilite demandee par le sujet.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Sonde de sante du frontend lui-meme (ne depend de rien).
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout    10s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
